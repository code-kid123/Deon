generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  REVOKED
  REFUNDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum VariantStatus {
  ACTIVE
  HIDDEN
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  PARTIALLY_FULFILLED
  CANCELLED
  REFUNDED
  FAILED
}

enum OrderType {
  CART
  COURSE
  MENTORSHIP
  CONSULTATION
}

enum BookingType {
  WARDROBE_AUDIT
  STYLE_CONSULTATION
  BRAND_STRATEGY
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MentorshipApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  COMPLETED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  phone     String?
  authId    String?    @unique @map("auth_id")
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  orders                 Order[]
  enrollments            Enrollment[]
  consultationBookings   ConsultationBooking[]
  mentorshipApplications MentorshipApplication[]

  @@map("users")
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  subtitle    String?
  description String?
  coverImage  String?      @map("cover_image")
  status      CourseStatus @default(DRAFT)
  currency    String       @default("NGN")
  featured    Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tiers     CourseTier[]
  modules   CourseModule[]
  enrollments Enrollment[]

  @@map("courses")
}

model CourseTier {
  id           String  @id @default(cuid())
  courseId     String  @map("course_id")
  name         String
  priceMinor   Int     @map("price_minor")
  features     Json?
  position     Int     @default(0)
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]

  @@index([courseId])
  @@map("course_tiers")
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String   @map("course_id")
  title     String
  position  Int      @default(0)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   CourseLesson[]

  @@index([courseId])
  @@map("course_modules")
}

model CourseLesson {
  id              String       @id @default(cuid())
  moduleId        String       @map("module_id")
  title           String
  videoUrl        String?      @map("video_url")
  durationSeconds Int?         @map("duration_seconds")
  isPreview       Boolean      @default(false) @map("is_preview")
  position        Int          @default(0)
  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("course_lessons")
}

model Enrollment {
  id                        String           @id @default(cuid())
  userId                    String           @map("user_id")
  courseId                  String           @map("course_id")
  tierId                    String?          @map("tier_id")
  sourceOrderId             String?          @map("source_order_id")
  status                    EnrollmentStatus @default(PENDING)
  telegramInviteUrl         String?          @map("telegram_invite_url")
  telegramInviteExpiresAt   DateTime?        @map("telegram_invite_expires_at")
  telegramInviteRevokedAt   DateTime?        @map("telegram_invite_revoked_at")
  enrolledAt                DateTime         @default(now()) @map("enrolled_at")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tier     CourseTier?  @relation(fields: [tierId], references: [id])
  order    Order?       @relation(fields: [sourceOrderId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  parentId    String?   @map("parent_id")
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@map("categories")
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String?
  status        ProductStatus @default(DRAFT)
  currency      String        @default("NGN")
  categoryId    String?       @map("category_id")
  highlights    Json?
  care         Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  category Category?          @relation(fields: [categoryId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  url       String
  alt       String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id                String       @id @default(cuid())
  productId         String       @map("product_id")
  sku               String       @unique
  size              String?
  color             String?
  priceMinor        Int          @map("price_minor")
  compareAtPriceMinor Int?       @map("compare_at_price_minor")
  stock             Int          @default(0)
  status            VariantStatus @default(ACTIVE)
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id               String      @id @default(cuid())
  reference        String      @unique
  paystackReference String?    @unique @map("paystack_reference")
  userId           String?     @map("user_id")
  type             OrderType   @default(CART)
  status           OrderStatus @default(PENDING)
  currency         String      @default("NGN")
  subtotalMinor    Int         @default(0) @map("subtotal_minor")
  discountMinor    Int         @default(0) @map("discount_minor")
  shippingMinor    Int         @default(0) @map("shipping_minor")
  totalMinor       Int         @default(0) @map("total_minor")
  customerName     String?     @map("customer_name")
  customerEmail    String?     @map("customer_email")
  customerPhone    String?     @map("customer_phone")
  shippingAddress  Json?       @map("shipping_address")
  metadata         Json?
  paymentChannel   String?     @map("payment_channel")
  paidAt           DateTime?   @map("paid_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  user          User?          @relation(fields: [userId], references: [id])
  items         OrderItem[]
  transactions  PaymentTransaction[]
  enrollments   Enrollment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String  @map("order_id")
  productId      String  @map("product_id")
  variantId      String  @map("variant_id")
  productName    String  @map("product_name")
  sku            String
  size           String?
  color          String?
  unitPriceMinor Int     @map("unit_price_minor")
  quantity       Int     @default(1)
  lineTotalMinor Int     @map("line_total_minor")

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  reference   String   @unique
  orderId     String?  @map("order_id")
  eventType   String?  @map("event_type")
  amountMinor Int      @map("amount_minor")
  currency    String   @default("NGN")
  channel     String?
  status      String
  raw         Json?
  createdAt   DateTime @default(now()) @map("created_at")

  order Order? @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payment_transactions")
}

model MentorshipTier {
  id             String @id @default(cuid())
  slug           String @unique
  name           String
  priceMinor     Int    @map("price_minor")
  durationMonths Int    @map("duration_months")
  features       Json?
  position       Int    @default(0)

  applications MentorshipApplication[]

  @@map("mentorship_tiers")
}

model MentorshipApplication {
  id            String                     @id @default(cuid())
  userId        String?                    @map("user_id")
  tierId        String                     @map("tier_id")
  status        MentorshipApplicationStatus @default(PENDING)
  experienceLevel String?                  @map("experience_level")
  portfolioUrl  String?                    @map("portfolio_url")
  goals         String?
  notes         String?
  paymentReference String?                 @map("payment_reference")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  user User?            @relation(fields: [userId], references: [id])
  tier MentorshipTier   @relation(fields: [tierId], references: [id])

  @@index([userId])
  @@index([tierId])
  @@map("mentorship_applications")
}

model ConsultationBooking {
  id                 String       @id @default(cuid())
  calendlyEventUuid  String       @unique @map("calendly_event_uuid")
  userId             String?      @map("user_id")
  name               String?
  email              String?
  phone              String?
  bookingType        BookingType  @default(STYLE_CONSULTATION) @map("booking_type")
  calendarEventType  String?      @map("calendar_event_type")
  calendlyScheduledAt DateTime?   @map("calendly_scheduled_at")
  timezone           String?
  status             BookingStatus @default(CONFIRMED)
  paymentReference   String?      @map("payment_reference")
  inviteUrl          String?      @map("invite_url")
  rawPayload         Json?        @map("raw_payload")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("consultation_bookings")
}